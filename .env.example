# Copy to .env and fill in. Generate a key with:  python3 -c "import secrets; print(secrets.token_urlsafe(32))"
# Must be at least 32 characters. Enter the same key in the FitStream app.
FITSTREAM_API_KEY=

# Days of history shown on the dashboard.
FITSTREAM_DAYS=90

# Seconds between dashboard rebuilds (8 hours = roughly the blog's 8 AM / 2 PM / 8 PM schedule).
FITSTREAM_REBUILD_SECONDS=28800

# Host interface and port for nginx. Keep 127.0.0.1 and put an HTTPS tunnel or reverse proxy
# (Cloudflare Tunnel, Caddy, Tailscale Funnel) in front. The app only talks to https:// URLs.
FITSTREAM_BIND=127.0.0.1
FITSTREAM_PORT=8080
